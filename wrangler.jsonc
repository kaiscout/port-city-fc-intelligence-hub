{
  // Cloudflare Workers static-assets deployment of the public dashboard.
  // `npm run site:build` regenerates ./dist; `npm run cf:deploy` builds and uploads it.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pcfc-intelligence-hub",
  "account_id": "e37e60395246132a8b82855c6f6f1918",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "pcfc.denizci.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
  },
  "observability": { "enabled": true },
}
