model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US

	expression DataRoot = "REPLACE_WITH_REPOSITORY_PATH/data/processed/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

ref table DimDate
ref table DimProgram
ref table DimMetric
ref table DimCategory
ref table FactFinance
ref table FactFinanceCategory
ref table FactOperations

ref role MenProgramViewer
ref role WomenProgramViewer
