table 'DimProgram'
	column 'ProgramKey'
		dataType: string
		sourceColumn: ProgramKey
		isKey
		summarizeBy: none

	column 'Program'
		dataType: string
		sourceColumn: Program
		summarizeBy: none

	partition 'DimProgram' = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "dim_program.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"ProgramKey", type text}, {"Program", type text}}, "en-US")
			in
				Typed
