# Local PostgreSQL-backed development
DATABASE_URL=postgres://pcfc:local-development-only@127.0.0.1:5432/pcfc_hub
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://127.0.0.1:3000
DEMO_MODE=true
PUBLIC_DEMO_MODE=false
LOCAL_PREVIEW_MODE=false
PORTFOLIO_DISCLAIMER=true
LOG_LEVEL=info
DEMO_ADMIN_PASSWORD=replace-for-local-use
